# TSUNAMI client configuration for OpenWrt.
#
#   cp /usr/share/tsunami/tsunami.config.example /etc/config/tsunami
#   chmod 600 /etc/config/tsunami
#   vi /etc/config/tsunami        # set server and password, then enabled '1'
#   /etc/init.d/tsunami enable
#   /etc/init.d/tsunami start
#
# The password is handed to tsunami-client on its command line, so any local
# user can read it from /proc. Keep /etc/config/tsunami readable by root only.
#
# The proxies listen on the router's loopback by default. To serve LAN clients,
# bind to the LAN address (for example '192.168.1.1:1080') and keep the WAN
# firewall closed: an open SOCKS5 or HTTP proxy is an open relay.

config tsunami 'main'
	option enabled '0'
	option server 'example.com:443'
	option password ''
	option socks '127.0.0.1:1080'
	option http '127.0.0.1:8080'
	option fingerprint 'chrome'
	# option sni ''
	# option skip_verify '0'
	# option front_path '/assets/update'
	# option front_secret ''
	# option front_transport 'h2'
	# option max_connections '4'

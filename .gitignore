
/bin/

# Build output (versioned release directories + platform binaries)
/build/v*/
/build/linux-*/
/build/windows-*/
/build/darwin-*/
/build/vdev/
/build/*
# Release tooling lives in build/ and is tracked; only output is ignored.
!/build/*.sh
!/build/*.py
!/build/*.ps1
!/build/*.md
!/build/Makefile
!/build/openwrt/

# Binaries
*.exe
*.exe~
tsunami-server-linux
tsunami-client-linux
tsunami-*-linux-*

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
docs/TSUNAMI_project_technical_deck.pptx

